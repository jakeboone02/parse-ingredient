{
  "name": "parse-ingredient",
  "author": "Jake Boone",
  "version": "2.2.0",
  "type": "commonjs",
  "license": "MIT",
  "description": "Recipe ingredient parser with support for mixed numbers and vulgar fractions",
  "files": [
    "dist"
  ],
  "main": "./dist/cjs/index.js",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/parse-ingredient.d.mts",
        "default": "./dist/parse-ingredient.mjs"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "sideEffects": false,
  "types": "./dist/cjs/index.d.ts",
  "unpkg": "./dist/parse-ingredient.umd.min.js",
  "keywords": [
    "parse",
    "recipe",
    "ingredient",
    "quantity",
    "number"
  ],
  "bugs": {
    "url": "https://github.com/jakeboone02/parse-ingredient/issues"
  },
  "homepage": "https://github.com/jakeboone02/parse-ingredient",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jakeboone02/parse-ingredient.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "bun --hot ./index.html",
    "build": "bun --bun x tsdown",
    "docs": "typedoc",
    "generate:ci-examples": "bun scripts/generateCIExamples.ts",
    "test": "bun test",
    "watch": "bun test --watch",
    "lint": "bunx oxlint",
    "fmt": "oxfmt",
    "publish:npm": "np"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^26.4.0",
    "@types/web": "^0.0.354",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "format-quantity": "^3.2.0",
    "np": "^12.0.1",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsdown": "^0.22.14",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "numeric-quantity": "^3.3.1"
  }
}
